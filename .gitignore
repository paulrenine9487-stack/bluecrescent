# Node Modules (dependencies)
node_modules/
**/node_modules/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local

# Production Build Directories
dist/
**/dist/
build/
**/build/

# OS-Specific files
.DS_Store
Thumbs.db

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE/Editor config
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Server uploaded files (large binaries - must not be committed)
# The directory itself is tracked via server/uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep

# Also ignore legacy client/public/uploads (in case any old files are there)
client/public/uploads/*
!client/public/uploads/.gitkeep
